# Copy to .env and export these before starting (e.g. `export $(grep -v '^#' .env | xargs)`).
PORT=3000
# Long random string used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to 1 when served over HTTPS so cookies are marked Secure.
COOKIE_SECURE=0
# Set to 1 when running behind a reverse proxy / load balancer (uses X-Forwarded-For for rate limits).
TRUST_PROXY=0
# Optional: enables the AI "Séance" copywriter. Without it a built-in template generator is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: SQLite file location.
DB_PATH=./data/geoghosts.db
